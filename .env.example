# Generated by Darkroom setup wizard, or copy from this file.
# Never commit a real .env.

PORT=3001
COMFY_URL=http://127.0.0.1:8188

# local = Darkroom can start ComfyUI and manage models under COMFY_DIR
# remote = URL only; launcher will not start ComfyUI; model tools are hidden
COMFY_MODE=local

# Local installs only:
# Windows portable: folder containing python_embeded\ and ComfyUI\
# macOS/Linux: folder containing main.py (and usually venv/)
# COMFY_DIR=/path/to/ComfyUI
# COMFY_PYTHON=/path/to/python   # optional override; auto-detected from venv / python_embeded

# ComfyUI --preview-method (default: auto)
# COMFY_PREVIEW_METHOD=auto

# Optional download tokens
# CIVITAI_TOKEN=
# HF_TOKEN=

# MOCK=true
